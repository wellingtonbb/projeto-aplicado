APP_NAME="Secure Web Application"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Sem Banco de Dados (Requisito 9: Database-less)
DB_CONNECTION=null

# Sessão e Cache em Arquivo (Requisito 18: Sessão Segura)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Autenticação Segura sem Banco (Requisito 12: Hash Bcrypt)
# Exemplo padrão: admin / Admin@Secure2025!
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH='$2y$12$1tDlujExoxJIB4kICHkmre7qCirbuJjQp4mPSigl7Rmd3PN3BXdwO'

# Rate Limiting (Requisito 17: Brute Force Protection)
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=1
